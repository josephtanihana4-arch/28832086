# Target Solana Network (mainnet-beta | mainnet-2 | devnet | testnet)
SOLANA_CLUSTER=mainnet-2
SOLANA_RPC_URL=http://127.0.0.1:3000/api/rpc/mainnet-2
# Solana Mainnet 2 Blockchain RPC Link (accepts all transactions, wallet transfers, staking & balances)
SOLANA_MAINNET_2_RPC_URL=http://127.0.0.1:3000/api/rpc/mainnet-2
# Optional: Live SolPool Developer JSON-RPC 2.0 Link (e.g. https://<your-app-url>/api/rpc/mainnet-2)
SOLANA_DEV_RPC_LINK=http://127.0.0.1:3000/api/rpc/mainnet-2

# Path to Solana CLI keypair JSON (used for signing pool creation / staking transactions)
KEYPAIR_PATH=~/.config/solana/id.json

# Optional: Existing standalone Stake Pool address once deployed
STAKE_POOL_ADDRESS=5pLwUFj82kustkYKdB4KL9SrfenstxctafXdGtsymJHS
